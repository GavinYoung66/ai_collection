# === API 网关（.env 为唯一事实源；启动时由 deploy/gateway/docker-entrypoint.sh
# 以 envsubst 白名单渲染 nginx.conf.template；改值后需重启网关容器生效）===
# upstream 值不带 http:// scheme：nginx upstream 的 server 指令不接受 scheme
#（实测 emerg: invalid host in upstream），只写 host:port。
UPSTREAM_COMPLAINT=complaint-service:8000
UPSTREAM_QC=qc-service:8000
UPSTREAM_RAG=rag-service:8000
UPSTREAM_WEB=gradio:7860
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ENABLE_AUTH=false
TLS_ENABLED=false
CANARY_WEIGHT=0
LOG_JSON=false
# tasks 3-10 鉴权落地后使用；JWT_SECRET 复用上方。API_KEYS 逗号分隔。
JWT_ISSUER=
JWT_AUDIENCE=
API_KEYS=
# === RAG V2 功能开关（默认全 false = V1 行为） ===
KB_QUERY_REWRITE_ENABLED=false
KB_ROUTING_ENABLED=false
KB_WEIGHTING_ENABLED=false
KB_ROW_LEVEL_ENABLED=false
KB_MULTITURN_ENABLED=false
KB_EMBED_DEGRADED_KEEP_TEXT=false
ES_DUAL_WRITE=false
# === RAG V3 功能开关（默认全 false = V2 行为） ===
KB_OCR_ASR_DEGRADED_KEEP_TEXT=false
KB_ES_DEGRADED_KEEP_MILVUS=false
# === RAG V4 功能开关（默认全 false = V3 行为） ===
KB_SUMMARY_ENABLED=false
KB_SUMMARY_ES_BOOST=1.0
KB_SUMMARY_MAX_LEN=200
KB_ASR_OPENING_TRIM_ENABLED=false
# === RAG V5 功能开关与配置 ===
KB_LLM_ANSWER_ENABLED=true
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
DEEPSEEK_API_KEY=ENC[AES256_GCM,data:LkkIHGpYm3FlDOVSEPYT8oWfw1eCd2au5IHEkUPDPWTF+Ok=,iv:NNCL/T921cKJnPZodRFEGTR1QE7Q1A2zGz/NUw+Bb1A=,tag:qFGU2+gaouqVtyZRmk3f6g==,type:str]
LLM_MAX_CONCURRENCY=4
KB_IMAGE_EXTRACT_ENABLED=true
KB_TABLE_EXTRACT_ENABLED=true
# === RAG Service（Redis 隔离 DB） ===
RAG_REDIS_DB=2
# === V5 Gradio 前端内部访问 token（admin 角色 JWT，72h 过期，需与 JWT_SECRET 一致） ===
RAG_API_TOKEN=ENC[AES256_GCM,data:WyjUHv0dmwQB05u3y1hiGCyHnRuTh9Hxaqq5wELYaITO7yiU81LweNG8cACfhnVVLA+0egNxoVYDHPqNtgCgch1Q50w+RZYcE5wgTHQjG4kZqLI8csI//PoOWb+jFrPnCpaEd0g4+Vc6IIsjkmdf9yO3L11UVnoK/avl6N3VUoYMnMDo6iG14tVD+NDO7AX4ka50cjfXEdqTzUKL4RMaty8HTfnh2L/ExPNPzavdF7tiAcEgemen5J/bZpwY,iv:Vhaoz3mxCsFBLrC2XJbVS6UpqJLzeubV+r+/v6jn/OY=,tag:2bBMcpfgwewGWWJtCRplgw==,type:str]
# === 业务参数 ===
CALL_ALLOWED_HOURS=08:00-21:00
CALL_DAILY_LIMIT_PER_USER=3
CALL_RETRY_INTERVAL_MIN=30
CALL_MAX_RETRY=3
CALL_MAX_CONCURRENCY=50
MAX_DIALOG_TURNS=15
# 检索闸门 1 阈值：与 V4 生产语义一致（0.6）。
# mock embedding 为 n-gram 特征向量，相关文本 IP 需实测确认 ≥0.6；
# 若冒烟检索偶发空结果，说明 mock 相似度不足，应调 mock 而非降低阈值。
RAG_SCORE_THRESHOLD=0.6
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RECOVERY=60
# === complaint-service V2 (local; do not commit) ===
# === complaint-service V2 LLM (synced from DASHSCOPE_/DEEPSEEK_ aliases) ===
USE_MOCK_LLM=false
SIM_AUTO_REVIEW=true
USE_MOCK_MCP=false
# 批次③ 进程内桥（仅 USE_MOCK_MCP=false 闭环验收时生效）：
# 容器内默认走 compose alias（http://data-platform:8000 / http://qc-service:8000）；
# 本机 uvicorn 直跑 complaint-service 时取消下面两行注释（dev compose 宿主端口 8001/8003）。
#DATA_PLATFORM_URL=http://localhost:8001
#QC_SERVICE_URL=http://localhost:8003
LLM_DASHSCOPE_API_KEY=ENC[AES256_GCM,data:qie6rlwOKyjH035c9tQEN4OvciIoJ5JmHWMBmQGmHvwDElWAlLbfr5yX6SErSUlFMlYzu9Dvt0Fth1Eu1yZrNAvEa00ueCZnuh5WmlVnLMcIn5ynJFsAx8rGqiaLFQQnMU1orGAwkwJYRbsKwECQ2HuVXmQ=,iv:wEBMc6sv8SkHd3h8rlAywtI7Zu93yhGJsqSjiX45Lrs=,tag:UB1QTozAIioRWnttc4ndMQ==,type:str]
LLM_API_KEY=ENC[AES256_GCM,data:7XoQe/+XfZlX0tOURDUKv7YS2ROaZT0U6nvs4gOAj3sQAvEp8+ESTycZws/b7tnTh4vYuqArQfwQK6pRBZwc1neaKIZMzuSPJqOSeDMOYczcXx1yKxDAjm3pfY91XWd7Q7Y+w1demYMSGbE1IixRrYgGGz4=,iv:q5G3X0WIqmv18iIEtjNPPIbwO2nBGgpCybOsARldc9A=,tag:0CY6yQueNwYRrMmjSGakSQ==,type:str]
LLM_DEEPSEEK_API_KEY=ENC[AES256_GCM,data:8nL9YLrrGm9SHGZEhuTaMgKMYFM+SHD8sZYoaT4iCdIL8yo=,iv:V46+QSTsXXCgkdxIv3VdQKwd1gaaUFBl1Xusgj5FJ68=,tag:nbn4iOMn0ZfUwL2D7DKTdQ==,type:str]
LLM_DEEPSEEK_BASE_URL=http://host.docker.internal:8000/v1
# === Event Bus (rocketmq-local-bus) ===
EVENT_BUS=rocketmq
ROCKETMQ_NAMESRV=rocketmq-namesrv:9876
ROCKETMQ_PROXY=rocketmq-proxy:8081
# === MCP Gateway (mcp-gateway-standalone) ===
# 服务名：熔断/限流 key 派生前缀（{svc}:mcp_degraded:{server} / {svc}:mcp_ratelimit:{server}）。
# 与 spec 键型 csmp:mcp_degraded:{server} 对齐；网关启动 set_default_service 读取，
# resolve_service_name 无配置会 fail-fast，故此处显式声明为单一事实源。
MCP_GATEWAY_SERVICE_NAME=csmp
# 网关地址：complaint-service（Agent 侧）经 MCP SDK client 连网关的地址（compose 显式传递）。
# 容器内一律用 docker network 服务名 + 内部端口 9000（宿主机映射 9009）；
# 宿主机本机调测时临时覆盖为 http://localhost:9009。
MCP_GATEWAY_URL=http://mcp-gateway:9000
# 网关鉴权开关（默认关闭直通）：false 时不校验凭证；true 时 POST /mcp 与 GET /metrics
# 需 Authorization: Bearer <JWT|API Key>（/health 始终放行）。
MCP_GATEWAY_ENABLE_AUTH=false
# 网关 API Key（MCP_GATEWAY_ENABLE_AUTH=true 时生效；常量时间比对，留空表示仅接受 JWT）。
MCP_GATEWAY_AUTH_API_KEY=
# === 批次5压测: 三档爬坡（4/8/16）结论：最终定档 8（5.2）===
# 三档 100 案墙钟 26.0/25.5/25.1min 持平，瓶颈为单卡 vLLM 吞吐；
# 且 common/eventbus rocketmq SimpleConsumer.receive 批大小=8 硬顶。
# >8 需改批大小源码（超出本 change 范围，已登记技术债 README §8.2）。
ROCKETMQ_CONSUMER_PARALLELISM=8
LLM_RATE_LIMIT=60
# 全本地压测强制锁死本地 vLLM，禁止失败回退到付费 dashscope。
# 真实付费兜底仅在你显式改回多模型链时恢复。
LLM_FALLBACK_CHAIN=deepseek-chat
# 本地 vLLM 0.6.2：outlines 保证 schema 正确但慢，并发会拖垮吞吐；串行 + 大超时是最稳路径。
LLM_RESPONSE_FORMAT_JSON=1
LLM_HTTP_TIMEOUT=600
