# 宿主机进程（uvicorn 直跑 / 本地脚本）走 localhost
LANGFUSE_BASE_URL=http://localhost:3000
# 容器内进程走 host.docker.internal（docker-compose.dev.yml / .complaint.yml 透传时读此值）
LANGFUSE_BASE_URL_DOCKER=http://host.docker.internal:3000
