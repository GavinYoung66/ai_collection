# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# 最小闭环事件逻辑库：qc-service 与 data-platform 同一实例 SELECT 3；禁止 0 号库
QC_REDIS_DB=3
# === Milvus ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
# === Elasticsearch ===
ES_HOST=localhost
ES_PORT=9200
# 大模型 API KEY
