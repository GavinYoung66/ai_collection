# === 链路追踪统一开关（LangSmith）===
# 开启（两步）：① 下一行 false 改成 true ② 去掉 API Key 那行开头的 "# "。
# 关闭：把 true 改回 false 即可，全线不建 run、不写 SDK 环境变量、不外链。
# 全项目唯一开关，勿在其它段落重复定义；逻辑见 common/trace/langsmith_gate.py
LANGSMITH_ENABLED=false
# 下面这行 API Key 保留备查、禁止删除；⚠ 行尾不要追加任何中文或空格，
# 否则会被当成 Key 的一部分导致认证失败。
# LANGSMITH_API_KEY=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
LANGSMITH_PROJECT="ai_collection"
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACE_URL_TEMPLATE=
# === 链路追踪统一开关（Langfuse，本地自托管）===
# 本地实例 UI：http://localhost:3000 （docker compose up -d 起 6 个容器）
# 开启（两步）：① 保持 LANGFUSE_ENABLED=true ② 填入「本地实例」Settings 里新建的 Key。
# 关闭：把 true 改回 false 即可，全线不建 span、不写 SDK 环境变量。
# 全项目唯一开关，勿在其它段落重复定义；逻辑见 common/trace/langfuse_gate.py
# ⚠ Key 必须来自本地实例；用 cloud.langfuse.com 的 Key 打本地会 401（认证失败、无 trace）。
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=ENC[AES256_GCM,data:1lapGIiS0X6ocywnVK3Ok8hkK8+OL/bdenfnS+kKbe2hpP9HmWNAiOA8,iv:faY1qB5jxhM+oI3t6U5UksLDIp8XMRNvBflBe8B7iVk=,tag:IZDG54DNe35TXCHuic/MpA==,type:str]
