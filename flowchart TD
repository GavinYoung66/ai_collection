flowchart TD
    subgraph S0["阶段0 贷后案件接入（原业务系统 → 数据中台）"]
        A1["① 客户贷款逾期<br/>原业务系统生成原始案件<br/>（身份/贷款/金额/逾期天数/产品/还款记录）"]
        A2["② 原业务系统发布 case.overdue.created 事件"]
        A3["③ 数据中台【订阅者】收到事件<br/>→ 主动拉取案件数据 → 预处理<br/>（PII加密/字段标准化/生成快照行，质检列+投诉列留空）"]
        A1 --> A2 --> A3
    end

    subgraph S1["阶段1 分案下发"]
        B1["④ 数据中台【发布者】发 case.ready.assign 事件"]
        B2["⑤ 分案子系统【订阅者】收到<br/>→ 拉取案件数据 → 按规则分配<br/>→ 下发到催收员名下（20~50条/人）<br/>→ 回写分案结果到数据中台"]
        B1 --> B2
    end

    subgraph S2["阶段2 外呼催收"]
        C1["⑥ 催收员/智能外呼打电话<br/>+ 短信通知还款时间金额"]
        C2["⑦ 通话记录+逐轮对话落数据中台<br/>（call_records / dialog_turns）"]
        C1 --> C2
    end

    subgraph S3["阶段3 合规质检（事件驱动 · 反向拉取）"]
        D1["⑧ 电话结束 → 发布 call.session.ended 事件"]
        D2["⑨ qc-service【订阅者】收到<br/>→ 主动拉取通话素材（qc-source 接口）<br/>→ 规则引擎开检（R03/R04/R11-R13 + RAG法规）"]
        D3["⑩ 质检结果落 qc_records/qc_violations<br/>→ 发布 qc.check.completed 事件"]
        D4["⑪ 数据中台【订阅者】收到 → 回流快照【质检三列】<br/>（第一路回流）"]
        D1 --> D2 --> D3 --> D4
    end

    subgraph S4["阶段4 客户投诉（事件驱动 · 反向拉取）"]
        E1["⑫ 客户主动来电投诉（辱骂/违规）<br/>→ 原业务系统投诉受理子系统生成投诉工单<br/>※ 项目内：数据中台模拟生成投诉工单数据（20~30条）"]
        E2["⑬ 数据中台【发布者】发 complaint.created 事件"]
        E3["⑭ 投诉研判【订阅者】收到 → 主动拉取投诉工单<br/>→ 建会话 → LangGraph多智能体研判<br/>（MCP桥取数 + RAG检索带源ID）<br/>→ 人审断点 → 人工approve"]
        E4["⑮ resume → 回流快照【投诉三列】<br/>（第二路回流；失败进重试队列不阻断）"]
        E1 --> E2 --> E3 --> E4
    end

    S0 --> S1 --> S2 --> S3 --> S4
    S3 -.->|"质检与投诉是两条独立链路<br/>投诉不从质检衍生"| S4

    subgraph HUB["数据中台 = 核心数据枢纽"]
        H1["原始数据接入 + 预处理"]
        H2["对外只读拉数接口"]
        H3["两路回流（质检列/投诉列）"]
        H4["快照表 dw.ads_case_loop<br/>= 全链路对账单一事实源"]
    end