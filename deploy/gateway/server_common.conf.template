# 指标导出（D10 / tasks 8.1-8.2）：反代到内网 nginx-prometheus-exporter。
# ENABLE_AUTH=true 时经 auth_request 鉴权（spec「仅内网或鉴权可达」）；
# false 时 include 为空文件 = 放行（本地/内网语义）。MUST NOT 加 limit_req——
# 高频抓取不得触发 429，保证监控连续性。
location = /metrics {
    include /etc/nginx/auth_request.conf;
    proxy_pass http://metrics;
    proxy_set_header Host $host;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
}

# stub_status 仅 docker 内网可抓（exporter 经 ai-shared-net 访问，172.x 命中 allow）。
# 实测（macOS Docker Desktop）：宿主机经 published 端口访问时源 IP 为宿主代理
# 地址 192.168.65.1（不在 172.16.0.0/12 段）→ 命中 deny，返回 403，与 spec
# 「外部 403」一致。Linux 上 docker-proxy 源 IP 可能落在 172.16/12 内（视同内网
# 放行），生产环境如需强制拒绝，以不发布 stub 路由或防火墙规则兜底。
location = /stub_status {
    stub_status;
    allow 172.16.0.0/12;
    deny all;
}

# Gradio 在子路径 /rag/ 下仍会向 origin 根请求 /manifest.json；
# 不拦会落到导航页 root 并写 error_log 404。归 Gradio/流式级超时（D9）。
location = /manifest.json {
    proxy_pass http://web/rag/manifest.json;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_connect_timeout 3s;
    proxy_read_timeout 120s;
    access_log off;
}

location /rag/ {
    proxy_pass http://web;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Trace-Id $trace_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 3s;
    proxy_read_timeout 120s;
    proxy_buffering off;
}

location /complaint/ {
    alias /usr/share/nginx/html/complaint/;
}

location /qc/ {
    alias /usr/share/nginx/html/qc/;
}

location / {
    root /usr/share/nginx/html/www;
}

error_page 429 = @rate_limited;
error_page 502 = @bad_gateway;
error_page 504 = @gateway_timeout;

# 鉴权失败统一信封（api-gateway-hardening / tasks 4.3）：
# 仅当 ENABLE_AUTH=true 时由 /etc/nginx/auth_request.conf 的
# `error_page 401 = @auth_required;` 引用；ENABLE_AUTH=false 时
# 无 error_page 401 指向此处，后端自有 401 不会被改写，保证零回归。
# 本 location 有自定义 add_header，server 级安全头不继承，须重复（tasks 6.1）。
location @auth_required {
    internal;
    default_type application/json;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Trace-Id, X-User-Id" always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    return 401 '{"code":"B0002","message":"请先登录","data":null,"trace_id":"$trace_id"}';
}

# 同上：有自定义 add_header，server 级安全头不继承，须重复（tasks 6.1）。
location @rate_limited {
    internal;
    default_type application/json;
    add_header Retry-After 1 always;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Trace-Id, X-User-Id" always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    return 429 '{"code":"B0006","message":"请求过于频繁","data":null,"trace_id":"$trace_id"}';
}

location @bad_gateway {
    internal;
    default_type application/json;
    return 502 '{"code":"B0008","message":"网关错误","data":null,"trace_id":"$trace_id"}';
}

location @gateway_timeout {
    internal;
    default_type application/json;
    return 504 '{"code":"B0009","message":"服务暂不可用","data":null,"trace_id":"$trace_id"}';
}
