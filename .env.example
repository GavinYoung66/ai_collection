# === 环境（platform） ===
ENV=dev

# === PostgreSQL（platform） ===
PG_HOST=localhost
PG_PORT=5432
PG_USER=ai_collection
PG_PASSWORD=<change_me>
PG_DB=ai_collection

# LangGraph checkpointer（complaint-service）：默认 false = 进程内 MemorySaver。
# 开启前须先 `alembic upgrade head`（0015_langgraph_checkpoint_tables）。
# COMPLAINT_CHECKPOINTER_PG=true
# COMPLAINT_PG_DSN=postgresql://ai_collection:<change_me>@localhost:5432/ai_collection

# === Redis（platform） ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# rag-service 独立逻辑库（与下方 QC_REDIS_DB=3 隔离，本地 .env 取 2）
RAG_REDIS_DB=<change_me>

# === qc-service（DD-02 §12；host 不含 /api/v1）===
# Redis 逻辑库 QC_REDIS_DB=3（同一 Redis 实例 SELECT 3，不是单独容器）。
# 容器网络用服务名；compose 内 uvicorn 听 8000，宿主机 qc=8003 / rag-service=8002 / dp=8001。
# Docker 演示默认：QC_RAG_SENSITIVE_BASE=http://rag-service:8000（容器内听 8000，~50 词 current.dict）
# 本机直跑 qc（宿主机映射 rag 8002）：QC_RAG_SENSITIVE_BASE=http://localhost:8002
# 不要把 rag-dict-mock（7 词）当演示默认；它与 rag-service 争用宿主机 8002。
QC_RAG_SENSITIVE_BASE=http://rag-service:8000
QC_RAG_INITIAL_TIMEOUT=3
QC_RAG_HOURLY_CRON="0 * * * *"
QC_DP_BASE=http://data-platform:8000
QC_DP_SESSION_PATH=/api/v1/data/sessions/{session_id}/qc-source
QC_DP_PENDING_QC_PATH=/api/v1/data/sessions:pending-qc
QC_DP_TIMEOUT=5
QC_LLM_MODEL=deepseek-flash
QC_LLM_TIMEOUT=20
QC_LLM_RETRY=3
QC_LLM_DEGRADE_AFTER=3
QC_DEDUP_WINDOW_MS=30000
QC_AUTO_START_ON_ENDED=true
QC_AUTO_COMPLEMENT_AFTER_ETL=true
QC_TEXT_READY_RETRY_SEC=30
QC_TEXT_READY_RETRY_MAX=20
QC_ALERT_LEVEL_MIN=high
QC_BATCH_MAX=100
QC_MOCK_LLM=false
QC_DEFAULT_ACTIVE_RULES_VERSION=v1.0
QC_R14_RAG_ENABLED=true
QC_REDIS_DB=3
# 无 QC_RESPONSE_TIMEOUT、无 QC_EVENT_ESCALATE_ENABLED

# === data-platform（最小闭环 data-platform/min-loop）===
# 复用同一个 QC_REDIS_DB（同一 Redis 实例 SELECT 3）发布 etl.task.done、订阅 qc.check.completed；
# 不另起 Redis 实例，禁止发 0 号库；data-platform 代码默认值同样为 3。
# 快照接口 GET/PUT /api/v1/data/snapshot/{case_id} 仅容器内网/本机可达，不配进 api-gateway。

# === Milvus（platform infra） ===
MILVUS_HOST=localhost
MILVUS_PORT=19530

# === Elasticsearch（platform infra） ===
ES_HOST=localhost
ES_PORT=9200

# === Embedding / Rerank（platform infra） ===
EMBEDDING_SERVICE_URL=http://localhost:8100

# === Rerank Service ===
RERANK_SERVICE_URL=http://localhost:8101

# === LLM Keys / defaults（platform；各服务编排另读） ===
LLM_API_KEY=<change_me>
# 多模型供应商密钥（按 LLM_PROVIDER 选用；与 .env 键集合对齐）
DASHSCOPE_API_KEY=<change_me>
# DEEPSEEK_API_KEY 见下方 RAG V5 段（历史上本地另存混合大小写键 DeepSeek_API_KEY，
# 加密规则按子串命中、二者均会被 sops 加密；新环境统一用大写 DEEPSEEK_API_KEY）
DeepSeek_API_KEY=<change_me>
ANTHROPIC_API_KEY=<change_me>
LLM_MODEL=qwen-plus
LLM_TIMEOUT=5
LLM_CONFIDENCE_THRESHOLD=0.7
# LLM 模型维限流（common.llm 单一事实源，invoke_llm 与投诉 real_transport 同读）：
# 每模型每窗口允许请求数 / 窗口秒数，按 {svc}:llm_ratelimit:{model} 分模型计数；
# 不设置即沿用默认 60/60（与改造前一致）；0/负数/非数字保守回退默认并打 warn，不阻断启动。
# 注入方式：compose 由 env_file 自动注入（改后需 recreate）；本机 uvicorn 直跑只认真实
# 环境变量、不会自动读本文件，须先 `set -a; source .env; set +a`（压测脚本已内置）。
# 另注意：阈值在进程启动（import common.llm.reliability）时读取一次，改后需重启进程生效。
LLM_RATE_LIMIT=60
LLM_RATE_WINDOW=60
# 兜底模型链（逗号分隔模型名，留空不兜底；本地压测可锁死单模型）
LLM_FALLBACK_CHAIN=<change_me>
# 是否强制 JSON 响应格式（1/0）；LLM HTTP 超时秒数（区别于上方 LLM_TIMEOUT 编排超时）
LLM_RESPONSE_FORMAT_JSON=<change_me>
LLM_HTTP_TIMEOUT=<change_me>

# === complaint-service（complaint）===
# USE_MOCK_LLM=false
# USE_MOCK_MCP=true
# 真路径 MCP：USE_MOCK_MCP=false 时必填，例 http://localhost:8002 或 http://rag-service:8000
# RAG_SERVICE_URL=
# LLM_DEEPSEEK_API_KEY=<change_me>
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DASHSCOPE_API_KEY=<change_me>

# === ASR (阿里云 NLS) ===
ASR_APP_KEY=<change_me>
ASR_ACCESS_TOKEN=<change_me>

# === TTS (阿里云 NLS) ===
TTS_APP_KEY=<change_me>
TTS_ACCESS_TOKEN=<change_me>

# === CCC (阿里云呼叫中心) ===
CCC_ACCESS_KEY_ID=<change_me>
CCC_ACCESS_KEY_SECRET=<change_me>

# === AES-256 加密密钥 ===
AES_KEY=<run: python -c "from secrets import token_bytes; print(token_bytes(32).hex())">

# === JWT ===
JWT_SECRET=<change_me>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# === API 网关（.env 为唯一事实源；deploy/gateway/docker-entrypoint.sh 以
# envsubst 白名单渲染 nginx.conf.template；改值后重启网关容器生效）===
# upstream 值不带 http:// scheme：nginx upstream 的 server 指令不接受 scheme，
# 只写 host:port。
UPSTREAM_COMPLAINT=complaint-service:8000
UPSTREAM_QC=qc-service:8000
UPSTREAM_RAG=rag-service:8000
UPSTREAM_WEB=gradio:7860
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ENABLE_AUTH=false
TLS_ENABLED=false
CANARY_WEIGHT=0
LOG_JSON=false
# tasks 3-10 鉴权落地后使用；JWT_SECRET 复用上方。
# JWT_ISSUER / JWT_AUDIENCE 例：issuer=https://auth.example.com audience=api
# API_KEYS 逗号分隔、无空格，例：API_KEYS=ak-xxx,ak-yyy
JWT_ISSUER=
JWT_AUDIENCE=
API_KEYS=

# === V5 Gradio 前端内部访问 token（admin 角色 JWT；rag-service 校验，需与 JWT_SECRET 同一签发体系） ===
RAG_API_TOKEN=<change_me>

# === RAG 产品开关（rag-service / RagSettings；不在 common 平台 Settings） ===
KB_QUERY_REWRITE_ENABLED=false
KB_ROUTING_ENABLED=false
KB_WEIGHTING_ENABLED=false
KB_ROW_LEVEL_ENABLED=false
KB_MULTITURN_ENABLED=false
KB_EMBED_DEGRADED_KEEP_TEXT=false
ES_DUAL_WRITE=false

# === RAG V3 功能开关（默认全 false = V2 行为） ===
KB_OCR_ASR_DEGRADED_KEEP_TEXT=false
KB_ES_DEGRADED_KEEP_MILVUS=false

# === RAG V4 功能开关（默认全 false = V3 行为） ===
KB_SUMMARY_ENABLED=false
KB_SUMMARY_ES_BOOST=1.0
KB_SUMMARY_MAX_LEN=200
KB_ASR_OPENING_TRIM_ENABLED=false

# === RAG V5 功能开关与配置（默认全 false = V4 行为） ===
# LLM_MODEL / LLM_TIMEOUT 复用上方既有配置：LLM_MODEL=qwen-plus；LLM_TIMEOUT 类默认 10，本文件登记 5 供本地覆盖；V5 不重复定义、不改默认值
KB_LLM_ANSWER_ENABLED=false
LLM_PROVIDER=dashscope
LLM_MAX_CONCURRENCY=4
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
KB_IMAGE_EXTRACT_ENABLED=true
KB_TABLE_EXTRACT_ENABLED=false
KB_EXCEL_SHEET_ALL=true
KB_EXCEL_HEADER_ROW=1
KB_ASR_AMR_WMA_ENABLED=false
KB_ASSETS_DIR=data/assets
KB_ASSETS_MAX_SIZE=1024

# === RAG V5 功能开关与配置（默认全 false = V4 行为） ===
KB_LLM_ANSWER_ENABLED=true
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
DEEPSEEK_API_KEY=
LLM_MAX_CONCURRENCY=4
# === 链路追踪统一开关（LangSmith）===
# 全项目唯一开关；false 时全线不追踪（不建 run / 不写 SDK 环境变量 / 不外链）
# 逻辑见 common/trace/langsmith_gate.py；各服务默认 project 由闸门 fallback 兜底
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai_collection
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 可选：LangSmith「打开」外链模板（无此变量则隐藏按钮，避免错误 404）
# 占位符 {run_id} {project}；示例：
# LANGSMITH_TRACE_URL_TEMPLATE=https://smith.langchain.com/o/<org>/projects/p/{project}/r/{run_id}
LANGSMITH_TRACE_URL_TEMPLATE=

# === 链路追踪统一开关（Langfuse，本地自托管）===
# 全项目唯一开关；false 时全线不追踪（不建 span / 不写 SDK 环境变量）
# 逻辑见 common/trace/langfuse_gate.py；本地实例 UI 默认 http://localhost:3000
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 宿主机进程用 localhost；容器内进程用 LANGFUSE_BASE_URL_DOCKER（compose 透传时读取）
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_BASE_URL_DOCKER=http://host.docker.internal:3000

# === RAG 文档入库限制（对齐 DD-03 §8） ===
KB_MAX_FILE_SIZE=20971520
KB_PARSE_TIMEOUT=30
KB_INGEST_JOB_TIMEOUT=1800
KB_INGEST_STAGING_DIR=data/ingest_staging

# === RAG 检索：同文档多 chunk 保留数（RRF 后 doc_id top-N，N = min(top_k, keep)） ===
KB_DOC_CHUNK_KEEP=5

# === RAG 探活降级模式（true = 依赖失败只告警，status=degraded 不判 unhealthy） ===
KB_HEALTH_DEGRADED_MODE=false

# === 业务参数 ===
CALL_ALLOWED_HOURS=08:00-21:00
CALL_DAILY_LIMIT_PER_USER=3
CALL_RETRY_INTERVAL_MIN=30
CALL_MAX_RETRY=3
CALL_MAX_CONCURRENCY=50
MAX_DIALOG_TURNS=15
RAG_SCORE_THRESHOLD=0.6
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RECOVERY=60

# === Event Bus (rocketmq-local-bus) ===
# redis=灰度对照；rocketmq=目标模式（arm64 spike go）
EVENT_BUS=rocketmq
ROCKETMQ_NAMESRV=rocketmq-namesrv:9876
ROCKETMQ_PROXY=rocketmq-proxy:8081
# RocketMQ 消费并行度（common/eventbus RocketMQEventBus，经 factory 注入）：
# 默认 1 = 同批消息逐条串行处理并逐条确认，与既有行为完全一致，qc/dp/rag 零感知；
# 调大后同一批 receive 的消息以 asyncio.gather 并发处理、Semaphore 限制在途 handler 数，
# 单条失败不影响同批（未确认条由 Broker 不可见超时重投）。不设/非法值回退 1。
ROCKETMQ_CONSUMER_PARALLELISM=1
# data-platform 信封瘦身后反拉质检详情（容器内用 http://qc-service:8000/api/v1）
QC_SERVICE_URL=http://localhost:8003/api/v1
QC_HTTP_TIMEOUT=5.0
QC_HTTP_RETRY=3

# complaint-service：judge 停在 human_review 后同栈 auto-approve（默认关；验收/min-loop 显式 true）
SIM_AUTO_REVIEW=false

# === MCP Gateway (mcp-gateway-standalone) ===
# 服务名：熔断/限流 key 派生前缀（{svc}:mcp_degraded:{server}）。网关启动 set_default_service 读取。
MCP_GATEWAY_SERVICE_NAME=csmp
# Agent 侧（complaint-service）连网关地址；容器内用服务名 + 内部端口 9000（宿主机映射 9009）
MCP_GATEWAY_URL=http://mcp-gateway:9000
# 网关鉴权开关（默认关闭直通；true 时 POST /mcp 与 GET /metrics 需 Bearer 凭证，/health 始终放行）
MCP_GATEWAY_ENABLE_AUTH=false
# 网关 API Key（ENABLE_AUTH=true 时生效；留空表示仅接受 JWT）
MCP_GATEWAY_AUTH_API_KEY=

# === Grafana（openspec change: observability-metrics-llm-usage）===
# Grafana 管理员密码：主 docker-compose.yml 的 grafana 服务经 GF_SECURITY_ADMIN_PASSWORD 读取，
# 用于登录 http://localhost:3000；生产/共享环境务必改为强随机值（.env.enc 重加密由运维手工操作）
GRAFANA_ADMIN_PASSWORD=<change_me>
