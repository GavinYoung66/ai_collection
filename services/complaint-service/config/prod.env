# complaint-service prod 环境配置（批次11 / 13.3.4）
# 用途：生产环境，MCP 独立容器，真实 LLM/MCP，完整三级模型链，熔断强制开启
# 生产禁止项（正向保证）：
#   - MCP_GATEWAY_MODE=standalone（禁止进程内 MCP）
#   - LLM_CIRCUIT_BREAKER_THRESHOLD=3 / RECOVERY=60（熔断开启，未关闭）
#   - USE_MOCK_MCP=false / USE_MOCK_LLM=false（接真实服务）
#   - 密钥均为占位，由部署/KMS 注入，不硬编码
# 注：不引入 COT_PLAINTEXT / MASKING_DISABLED / CIRCUIT_BREAKER_DISABLED /
#     USE_UNREVIEWED_PROMPT 等伪安全开关字段；CoT 加密/脱敏/Prompt 评审由
#     对应模块代码与流水线门禁保证。

ENV=prod

# ── 基础设施 ──
PG_HOST=postgres
PG_PORT=5432
PG_USER=ai_collection
PG_PASSWORD=change_me
PG_DB=ai_collection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=6

# ── MCP 网关：prod 独立容器（禁止进程内）──
MCP_GATEWAY_MODE=standalone
MCP_GATEWAY_URL=http://mcp-gateway:9000
# rag_kb 真路径 bridge（D2）；缺省或 change_me 时启动 fail-fast
RAG_SERVICE_URL=http://rag-service:8000

# ── Mock 开关：prod 关闭 ──
USE_MOCK_MCP=false
USE_MOCK_LLM=false

# ── LLM 模型链：deepseek-r1 主 + qwen-plus 一级备 + qwen-turbo 二级备 ──
LLM_MODEL_PRIMARY=deepseek-r1
LLM_MODEL_FALLBACK_1=qwen-plus
LLM_MODEL_FALLBACK_2=qwen-turbo

# ── LLM 凭据（占位，由 KMS / 部署平台注入）──
LLM_API_KEY=change_me
LLM_DEEPSEEK_API_KEY=change_me
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DASHSCOPE_API_KEY=change_me
LLM_COT_KEY=change_me

# ── AES / JWT（占位，由 KMS 注入）──
AES_KEY=change_me
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── 业务参数 ──
COMPLAINT_MAX_LOOPS=3
COMPLAINT_TASK_TIMEOUT=1800
COMPLAINT_MAX_TOKENS=50000
COMPLAINT_MAX_ACTIVE=20

# ── 日志 / 熔断（prod 熔断强制开启）──
LOG_LEVEL=INFO
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RECOVERY=60
LLM_TIMEOUT=30
LLM_CONFIDENCE_THRESHOLD=0.7
