# complaint-service pre 环境配置（批次11 / 13.3.3）
# 用途：预发环境，MCP 独立容器，真实 LLM/MCP，deepseek-r1 + qwen-plus，INFO 日志
# 灰度模式：运行时通过 /api/v1/complaints/mode 接口设置 gray_percent，不在此写伪造 GRAY_* 变量

ENV=pre

# ── 基础设施 ──
PG_HOST=postgres
PG_PORT=5432
PG_USER=ai_collection
PG_PASSWORD=change_me
PG_DB=ai_collection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=6

# ── MCP 网关：pre 独立容器 ──
MCP_GATEWAY_MODE=standalone
MCP_GATEWAY_URL=http://mcp-gateway:9000
RAG_SERVICE_URL=http://rag-service:8000

# ── Mock 开关：pre 关闭，接真实服务 ──
USE_MOCK_MCP=false
USE_MOCK_LLM=false

# ── LLM 模型链：deepseek-r1 主 + qwen-plus 备 ──
LLM_MODEL_PRIMARY=deepseek-r1
LLM_MODEL_FALLBACK_1=qwen-plus
LLM_MODEL_FALLBACK_2=

# ── LLM 凭据（占位，由部署注入真实值）──
LLM_API_KEY=change_me
LLM_DEEPSEEK_API_KEY=change_me
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DASHSCOPE_API_KEY=change_me
LLM_COT_KEY=change_me

# ── AES / JWT（占位）──
AES_KEY=change_me
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── 业务参数 ──
COMPLAINT_MAX_LOOPS=3
COMPLAINT_TASK_TIMEOUT=1800
COMPLAINT_MAX_TOKENS=50000
COMPLAINT_MAX_ACTIVE=20

# ── 日志 / 熔断 ──
LOG_LEVEL=INFO
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RECOVERY=60
LLM_TIMEOUT=30
LLM_CONFIDENCE_THRESHOLD=0.7

# ── 链路追踪开关（LangSmith）统一在仓库根 .env，本文件不再定义 ──
# 本地运行请从仓库根目录启动（pydantic 读根 .env）或显式 --env-file 指向根 .env。
# 逻辑见 common/trace/langsmith_gate.py；本地时间线（进程内存 trace_events）为 P0，不受影响。
