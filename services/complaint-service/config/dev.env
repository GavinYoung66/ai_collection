# complaint-service dev 环境配置（批次11 / 13.3.1）
# 用途：本地开发，MCP 进程内，Mock 全开，qwen-turbo 省钱，DEBUG 日志
# 加载：由 compose env_file 或本机 .env 切换注入；密钥为占位，生产由部署注入

ENV=dev

# ── 基础设施（容器内服务名）──
PG_HOST=postgres
PG_PORT=5432
PG_USER=ai_collection
PG_PASSWORD=change_me
PG_DB=ai_collection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=6

# ── MCP 网关：dev 进程内 ──
MCP_GATEWAY_MODE=inline
MCP_GATEWAY_URL=

# ── Mock 开关：dev 默认全开；真 LLM 联调时改 compose/.env：USE_MOCK_LLM=false（MCP 仍 true）──
USE_MOCK_MCP=true
USE_MOCK_LLM=false

# ── LLM 模型链：dev 仅 qwen-turbo ──
LLM_MODEL_PRIMARY=qwen-turbo
LLM_MODEL_FALLBACK_1=
LLM_MODEL_FALLBACK_2=

# ── LLM 凭据（占位，不入库真实密钥；真 Key 只放仓库根 .env）──
# 详见 docs/complaint-service/real-llm.md
LLM_API_KEY=change_me
LLM_DEEPSEEK_API_KEY=change_me
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DASHSCOPE_API_KEY=change_me

# ── CoT 加密密钥（dev stub，prod 由 KMS 注入）──
LLM_COT_KEY=dev_cot_key_stub_change_me

# ── AES / JWT（占位）──
AES_KEY=change_me
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── 业务参数 ──
COMPLAINT_MAX_LOOPS=3
COMPLAINT_TASK_TIMEOUT=3600
COMPLAINT_MAX_TOKENS=50000
COMPLAINT_MAX_ACTIVE=20

# ── 日志 / 熔断（dev 宽松：熔断阈值 9999 近似关闭，方便调试）──
LOG_LEVEL=DEBUG
LLM_CIRCUIT_BREAKER_THRESHOLD=9999
LLM_CIRCUIT_BREAKER_RECOVERY=60
LLM_TIMEOUT=30
LLM_CONFIDENCE_THRESHOLD=0.7

# ── 链路追踪开关（LangSmith）统一在仓库根 .env，本文件不再定义 ──
# 本地运行请从仓库根目录启动（pydantic 读根 .env）或显式 --env-file 指向根 .env。
# 逻辑见 common/trace/langsmith_gate.py；本地时间线（进程内存 trace_events）为 P0，不受影响。
